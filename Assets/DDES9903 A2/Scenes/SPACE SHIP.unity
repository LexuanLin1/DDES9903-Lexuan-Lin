  noEnergyCoreVoice: {fileID: 8300000, guid: 3a5813306c2442142867182878660ddc, type: 3}
  returnConfirmedVoice: {fileID: 8300000, guid: b3ec236816a13234e85733c9692fe7ab, type: 3}
  stayConfirmedVoice: {fileID: 8300000, guid: 044d13c3895412543bd22eef07e5bd91, type: 3}
  subtitleGroup: {fileID: 13585664}
  subtitleText: {fileID: 784163962}
  systemSubtitleColour: {r: 1, g: 0.75, b: 0.75, a: 1}
  miloSubtitleColour: {r: 0.65, g: 0.9, b: 1, a: 1}
  miloReadySubtitle: 'Captain... whatever you decide,

    I''m ready.'
  systemIntroSubtitle: 'Captain. Main power is nearly exhausted.

    The final escape
    pod is ready.

    Launching it will require the remaining energy of the Energy
    Core.'
  returnToEarthSubtitle: 'If you launch the escape pod, this vessel will lose its
    remaining power.

    You will have a chance to return to Earth and reunite with
    the family

    who has waited for you for ten years.

    The ship, and everything
    left aboard, may never return.'
  stayWithShipSubtitle: 'If you leave the Energy Core aboard, limited power may remain
    available

    for navigation and emergency transmission.

    There is a small
    possibility that the ship may reach an Earth orbital station,

    preserving
    your crew''s legacy and the story of this mission.'
  miloRescueSubtitle: 'MILO-01 can use the maintenance emergency pod to return ahead

    and
    transmit a distress signal.

    If you remain aboard, this will increase the
    possibility of rescue.'
  finalDecisionSubtitle: 'No recommendation will be made.

    The decision is yours,
    Captain.'
  noEnergyCoreSubtitle: 'Escape launch unavailable.

    Energy Core not detected.'
  returnConfirmedSubtitle: 'Return protocol confirmed.

    Escape pod access granted.'
  stayConfirmedSubtitle: 'Command acknowledged.

    The Energy Core will remain
    aboard.'
  startDelay: 0.6
  gapBetweenVoices: 0.7
  imagePreviewDelay: 0.5
  subtitleFadeDuration: 0.2
  subtitleExtraTime: 0.2
  fallbackVoiceDuration: 4
