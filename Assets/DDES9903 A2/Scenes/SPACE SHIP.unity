  stageSuccessSfx: {fileID: 0}
  stageFailureSfx: {fileID: 0}
  subtitleGroup: {fileID: 0}
  subtitleText: {fileID: 0}
  arrivalRecallSubtitle: "There\u2014the calibration array.\r\nCome on... work.\r\n\r\nRed
    for family,\r\ngreen for Earth,\r\nblue for crew.\r\n\r\nI have to restore my
    identity\r\nbefore this system traps me here for good."
  redMemorySubtitle: 'Come back to Earth.

    The garden will be green when you
    return.'
  greenMemorySubtitle: 'Earth memory recovered.

    Green land... blue oceans...
    home.'
  blueMemorySubtitle: 'Crew memory recovered.

    Explorer profile confirmed.'
  crewLogSubtitle: 'Emergency log.

    We transferred our remaining power to Pod
    One.

    One of us must make it back to Earth.'
  playerResponseSubtitle: 'They gave me their power...

    I won''t fail them. I''ll
    bring us home.'
  finalInstructionSubtitle: 'Identity verified.

    Retrieve the energy crystal
    and return to the lower cryosleep bay.'
  playerSubtitleColour: {r: 1, g: 1, b: 1, a: 1}
  memorySubtitleColour: {r: 0.85, g: 0.95, b: 1, a: 1}
