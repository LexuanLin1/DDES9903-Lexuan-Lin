  subtitleText: {fileID: 0}
  arrivalRecallSubtitle: "There\u2014the calibration array.\r\nCome on... work.\r\n\r\nRed
    for family,\r\ngreen for Earth,\r\nblue for crew.\r\n\r\nI have to restore my
    identity\r\nbefore this system traps me here for good."
  redMemorySubtitle: 'Come back to Earth.

    The garden will be green when you
    return.'
