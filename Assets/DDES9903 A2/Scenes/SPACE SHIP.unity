  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PostTeleportNarrativeSequence
  systemVoiceSource: {fileID: 219753709}
  systemVoiceClip: {fileID: 8300000, guid: 4f51d966d0028044d85d31b5c0cbe08e, type: 3}
  systemSubtitle: '

    Escape pod launch authorization incomplete.

    Main power
    is nearly exhausted.

    Orbital stability is failing.

    Captain, proceed
    to the bridge and make your final decision.'
  captainVoiceSource: {fileID: 826794624}
  captainVoiceClip: {fileID: 8300000, guid: 8f8c8fcc9da58da43b7a475eb55efb85, type: 3}
  captainSubtitle: 'The bridge... right.

    I need to decide what happens to the
    last of our power.

    If it still has power, I can break the lock.

    

    Move!'
  subtitleGroup: {fileID: 0}
  subtitleText: {fileID: 0}
  systemSubtitleColour: {r: 1, g: 0.65, b: 0.65, a: 1}
  captainSubtitleColour: {r: 1, g: 1, b: 1, a: 1}
